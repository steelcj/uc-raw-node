---
# ansible-lint configuration for uc-raw-node.
#
# Only one rule is turned off and one directory excluded, and nothing else
# may be skipped or excluded here: add a narrow "# noqa: <rule>" with a
# reason on the line instead.
#
# spike/ holds cloud-init user-data (whose "#cloud-config" header must stay
# exactly as written) and other non-Ansible files from the validation
# spike. It is reference material, not controller code.
exclude_paths:
  - spike/

#
# var-naming[no-role-prefix] wants every variable a role sets or reads to
# start with the full role name (raw_node_transport_incus_exec_,
# raw_node_validator_). The naming table in the Raw Node Controller Layout
# Design (en/docs/design/raw-node-controller-layout-design-*.md), section
# Variables, Naming, deliberately gives transports the shorter
# raw_node_<transport>_* prefix (raw_node_incus_*) and shares names
# across the controller and every transport (raw_node_hostname,
# raw_node_payload_file, raw_node_transport_*, raw_node_validation_*).
# tools/check_variables.py enforces that table instead.
skip_list:
  - var-naming[no-role-prefix]
